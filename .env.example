# Anthropic API Configuration
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx

# Azure Subscription & Resource Configuration
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_RESOURCE_GROUP=my-resource-group
AZURE_LOCATION=eastus

# Cosmos DB Configuration
AZURE_COSMOS_ENDPOINT=https://my-cosmosdb.documents.azure.com:443/
AZURE_COSMOS_KEY=your-cosmos-db-key

# Azure Blob Storage Configuration
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=mystorageaccount;AccountKey=...

# Source Data Configuration
SOURCE_MONGODB_URI=mongodb://localhost:27017/mydb
SOURCE_PATH=/path/to/source/files

# Migration Configuration
LOG_LEVEL=INFO
DRY_RUN=false
SAMPLE_SIZE=100
MIGRATION_BATCH_SIZE=1000

# Cost Estimation Configuration
ESTIMATED_DOCS_PER_MONTH=1000000
ESTIMATED_QUERY_RATE_PER_DAY=10000
ESTIMATED_STORAGE_GB=500

# Feature Flags
ENABLE_PII_SCAN=true
ENABLE_ENCRYPTION=true
ENABLE_COST_ESTIMATION=true
